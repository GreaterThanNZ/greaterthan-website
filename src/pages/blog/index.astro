---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Thinking" description="Writing on marketing strategy, leadership, and building businesses that last. Notes from the work.">

<!-- HERO -->
<section class="hero hero--sub section--indigo">
  <div class="container">
    <span class="eyebrow eyebrow--light reveal">Thinking</span>
    <h1>Notes from the work.</h1>
    <p class="lead">Writing on marketing strategy, leadership, and building businesses that last.</p>
  </div>
</section>

<!-- ARTICLES -->
<section class="section section--paper">
  <div class="container">
    <div class="journal-grid">
      <div class="journal-card reveal">
        <div class="img-placeholder" style="aspect-ratio: 16/9"><span>Photo</span></div>
        <div class="journal-card__body">
          <div class="journal-card__meta">
            <span class="journal-card__cat">Strategy</span>
            <span class="journal-card__time">5 min read</span>
          </div>
          <h3>When your marketing strategy doesn't match your business strategy</h3>
          <a href="#" class="journal-card__link">Read note <span class="arrow">→</span></a>
        </div>
      </div>

      <div class="journal-card reveal d1">
        <div class="img-placeholder" style="aspect-ratio: 16/9"><span>Photo</span></div>
        <div class="journal-card__body">
          <div class="journal-card__meta">
            <span class="journal-card__cat">Technology</span>
            <span class="journal-card__time">4 min read</span>
          </div>
          <h3>AI for marketing leaders: enablement over automation</h3>
          <a href="#" class="journal-card__link">Read note <span class="arrow">→</span></a>
        </div>
      </div>

      <div class="journal-card reveal d2">
        <div class="img-placeholder" style="aspect-ratio: 16/9"><span>Photo</span></div>
        <div class="journal-card__body">
          <div class="journal-card__meta">
            <span class="journal-card__cat">Models</span>
            <span class="journal-card__time">6 min read</span>
          </div>
          <h3>The fractional CMO model: when and why it works</h3>
          <a href="#" class="journal-card__link">Read note <span class="arrow">→</span></a>
        </div>
      </div>
    </div>

    <div class="blog-more reveal">
      <p>More articles coming soon.</p>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta-band">
  <div class="container">
    <div class="cta-band__inner">
      <h2>Want to talk strategy?</h2>
      <div class="cta-band__right">
        <span class="cta-band__email">hello@wearegreaterthan.co.nz</span>
        <a href="/contact" class="btn btn--primary-dark">Start a conversation <span class="arrow">→</span></a>
      </div>
    </div>
  </div>
</section>

</BaseLayout>
