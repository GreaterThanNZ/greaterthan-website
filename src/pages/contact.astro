---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Start a conversation with GreaterThan. Every engagement starts with a 30-minute discovery call.">

<!-- HERO -->
<section class="hero hero--sub section--indigo">
  <div class="container">
    <h1>Start a conversation.</h1>
    <p class="lead">Every engagement starts with a conversation. Tell us a little about your business and what you're working on.</p>
  </div>
</section>

<!-- CONTACT LAYOUT -->
<section class="section section--paper">
  <div class="container">
    <div class="contact-layout">

      <!-- LEFT: CONTACT DETAILS -->
      <div class="contact-details">
        <h2 class="reveal">Get in touch</h2>

        <div class="contact-item reveal d1">
          <div class="contact-item__label">Email</div>
          <a href="mailto:hello@wearegreaterthan.co.nz">hello@wearegreaterthan.co.nz</a>
        </div>

        <div class="contact-item reveal d2">
          <div class="contact-item__label">Location</div>
          <p>Based in Auckland, New Zealand</p>
        </div>

        <div class="contact-item reveal d2">
          <div class="contact-item__label">Coverage</div>
          <p>Working with businesses across NZ and Australia</p>
        </div>
      </div>

      <!-- RIGHT: BOOKING -->
      <div class="booking-box reveal">
        <h3>Book a discovery call</h3>
        <p>We'll find a time that works. A 30-minute conversation to understand your situation and whether we're the right fit.</p>

        <div class="booking-placeholder">
          <p>Booking system coming soon</p>
        </div>

        <p class="booking-note">
          In the meantime, email <a href="mailto:hello@wearegreaterthan.co.nz">hello@wearegreaterthan.co.nz</a> to arrange a time.
        </p>
      </div>

    </div>
  </div>
</section>

</BaseLayout>
