---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Strategy & Design Partner — Auckland, NZ">

<!-- 1. HERO -->
<section class="hero">
  <div class="container">
    <div class="hero__inner">
      <p class="hero__eyebrow">
        <span class="dot"></span>
        Strategy &amp; design partner — Auckland, NZ
      </p>
      <h1 class="hero__h1">Build things <em>worth</em> building.</h1>
      <p class="hero__lead">Most businesses reach a point where their marketing needs to be more strategic. You know where you want to go. You need a senior marketing partner who gets the business, not just the campaigns.</p>
      <div class="hero__actions">
        <a href="/contact" class="btn btn--primary-dark">Start a project <span class="arrow">→</span></a>
        <a href="/case-studies" class="btn btn--ghost-light">See our work</a>
      </div>

      <div class="stat-band">
        <div class="stat-band__item reveal">
          <div class="stat-band__num">30<em>+</em></div>
          <div class="stat-band__label">Years in brand and marketing</div>
        </div>
        <div class="stat-band__item reveal d1">
          <div class="stat-band__num">10<em>+</em></div>
          <div class="stat-band__label">Principal-led businesses served</div>
        </div>
        <div class="stat-band__item reveal d2">
          <div class="stat-band__num">4</div>
          <div class="stat-band__label">Years as an independent practice</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 2. TRUST MARQUEE -->
<section class="marquee-section">
  <p class="marquee-label">Trusted by leaders at</p>
  <div class="marquee-track">
    <div class="marquee-inner">
      <span>Prodotti</span>
      <span>·</span>
      <span>Longame</span>
      <span>·</span>
      <span>Anteris Psychiatry</span>
      <span>·</span>
      <span>Validus</span>
      <span>·</span>
      <span>Strategic Specialist Group</span>
      <span>·</span>
      <span>Visco</span>
      <span>·</span>
      <span>Lodge Cast Iron</span>
      <span>·</span>
      <span>Max Fitness College</span>
      <span>·</span>
      <span>Production Partners</span>
      <span>·</span>
      <span>SMP&amp;C</span>
      <!-- Duplicate for seamless loop -->
      <span>Prodotti</span>
      <span>·</span>
      <span>Longame</span>
      <span>·</span>
      <span>Anteris Psychiatry</span>
      <span>·</span>
      <span>Validus</span>
      <span>·</span>
      <span>Strategic Specialist Group</span>
      <span>·</span>
      <span>Visco</span>
      <span>·</span>
      <span>Lodge Cast Iron</span>
      <span>·</span>
      <span>Max Fitness College</span>
      <span>·</span>
      <span>Production Partners</span>
      <span>·</span>
      <span>SMP&amp;C</span>
    </div>
  </div>
</section>

<!-- 3. MANIFESTO -->
<section class="section section--paper">
  <div class="container">
    <span class="eyebrow reveal">Why we exist</span>
    <p class="manifesto__statement reveal d1">
      <em>Few</em> businesses fail for lack of activity. <span class="muted">Most fail because their marketing never connected to their strategy.</span>
    </p>
  </div>
</section>

<!-- 4. SERVICES - THREE LAYERS -->
<section class="section section--deep-blue">
  <div class="container">
    <span class="eyebrow eyebrow--light reveal">What we do</span>
    <div class="section-head reveal d1">
      <h2 style="color: var(--gt-white)">Three layers, <em>one</em> partner.</h2>
    </div>
    <p style="font-size: var(--fs-18); color: rgba(255,255,255,0.65); max-width: 60ch; margin-bottom: 0;" class="reveal d2">
      Every business needs different things at different times. GreaterThan works across three connected layers — alone or together, shaped to what your business needs right now.
    </p>

    <div class="services-grid">
      <div class="service-cell reveal">
        <div class="service-cell__index">01</div>
        <div class="service-cell__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="2" x2="12" y2="22"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            <line x1="2" y1="12" x2="22" y2="12"/>
          </svg>
        </div>
        <h3>Strategy &amp; Advisory</h3>
        <p>Direct guidance on marketing strategy, from the principal who leads it. Scoping, strategy assessment, capability evaluation, governance, planning oversight.</p>
        <ul class="service-cell__features">
          <li>Direction &amp; positioning</li>
          <li>Marketing roadmap</li>
          <li>Strategic governance</li>
        </ul>
      </div>

      <div class="service-cell reveal d1">
        <div class="service-cell__index">02</div>
        <div class="service-cell__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="0"/><line x1="3" y1="9" x2="21" y2="9"/>
            <line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="9" x2="9" y2="21"/>
          </svg>
        </div>
        <h3>Execution Support</h3>
        <p>When your strategy calls for a campaign, a rebrand, a new website, or AI enablement, GreaterThan scopes the brief, sources the right resource, and oversees it through to completion.</p>
        <ul class="service-cell__features">
          <li>Brief development</li>
          <li>Resource sourcing</li>
          <li>Project oversight</li>
        </ul>
      </div>

      <div class="service-cell reveal d2">
        <div class="service-cell__index">03</div>
        <div class="service-cell__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
          </svg>
        </div>
        <h3>Coaching &amp; Leadership</h3>
        <p>Where you have marketing talent inside the business who need to step up, GreaterThan coaches them directly. The focus is moving capability to the next tier.</p>
        <ul class="service-cell__features">
          <li>One-on-one coaching</li>
          <li>Strategic mentoring</li>
          <li>Leadership development</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- 5. SELECTED WORK -->
<section class="section section--light">
  <div class="container">
    <div class="work-header">
      <div class="section-head reveal" style="margin-bottom: 0">
        <span class="eyebrow">Selected work</span>
        <h2>Recent <em>projects</em>.</h2>
      </div>
      <a href="/case-studies" class="btn btn--ghost reveal">View all work <span class="arrow">→</span></a>
    </div>

    <div class="work-grid">
      <div class="work-card reveal">
        <div class="img-placeholder" style="aspect-ratio: 16/11"><span>Photo</span></div>
        <div class="work-card__body">
          <span class="work-card__eyebrow">Strategy &amp; Advisory</span>
          <h3>Prodotti. New Zealand's largest Mediterranean food and drink importer.</h3>
          <p>Led a comprehensive rebrand from Prodotti di Italia to Prodotti, then continued as fractional marketing manager across the full range.</p>
          <div class="work-card__meta">
            <span class="work-card__tag">Rebrand</span>
            <span class="work-card__date">2022–ongoing</span>
          </div>
        </div>
      </div>

      <div class="work-card reveal d1">
        <div class="img-placeholder" style="aspect-ratio: 16/10"><span>Photo</span></div>
        <div class="work-card__body">
          <span class="work-card__eyebrow">Strategy &amp; Advisory</span>
          <h3>Longame. From concept to market leader.</h3>
          <p>Led brand strategy and identity creation for a premium coffee brand entering a competitive market.</p>
          <div class="work-card__meta">
            <span class="work-card__tag">Brand strategy</span>
            <span class="work-card__date">2025–ongoing</span>
          </div>
        </div>
      </div>

      <div class="work-card reveal d2">
        <div class="img-placeholder" style="aspect-ratio: 16/10"><span>Photo</span></div>
        <div class="work-card__body">
          <span class="work-card__eyebrow">Execution Support</span>
          <h3>SMP&amp;C. Brand launch and AI integration.</h3>
          <p>Built market positioning for a new senior people-and-culture consultancy, then translated the brand into an installable AI plugin.</p>
          <div class="work-card__meta">
            <span class="work-card__tag">Brand launch</span>
            <span class="work-card__date">2024</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 6. APPROACH -->
<section class="section section--paper" id="approach">
  <div class="container">
    <span class="eyebrow reveal">How we work</span>
    <div class="section-head reveal d1">
      <h2>A way of working that <em>shows</em>.</h2>
    </div>

    <div class="approach-grid">
      <div class="approach-cell reveal">
        <div class="approach-cell__num">01</div>
        <h3>Read the business</h3>
        <p>Every engagement starts by understanding where the business is heading, what the marketing currently delivers, and what's needed next.</p>
      </div>
      <div class="approach-cell reveal d1">
        <div class="approach-cell__num">02</div>
        <h3>Build the strategy</h3>
        <p>The work that follows is shaped by what you find, not by what was expected when you walked in. Strategy before tactics, always.</p>
      </div>
      <div class="approach-cell reveal d2">
        <div class="approach-cell__num">03</div>
        <h3>Execute or enable</h3>
        <p>Deliver the strategy through the right people and resources — whether that's direct execution, vendor oversight, or coaching your team.</p>
      </div>
      <div class="approach-cell reveal d3">
        <div class="approach-cell__num">04</div>
        <h3>Hand it over well</h3>
        <p>Every engagement ends with the client in control. The goal is a marketing function that runs without constant external support.</p>
      </div>
    </div>
  </div>
</section>

<!-- 7. PROOF BAND -->
<section class="proof-band">
  <div class="container">
    <div class="proof-grid">
      <div class="proof-item reveal">
        <div class="proof-item__num">38<em>%</em></div>
        <p class="proof-item__label">Average increase in qualified leads reported by clients</p>
      </div>
      <div class="proof-item reveal d1">
        <div class="proof-item__num">12</div>
        <p class="proof-item__label">Years average client relationship length</p>
      </div>
      <div class="proof-item reveal d2">
        <div class="proof-item__num">40<em>+</em></div>
        <p class="proof-item__label">Campaigns and projects overseen</p>
      </div>
      <div class="proof-item reveal d3">
        <div class="proof-item__num">9<em>/</em>10</div>
        <p class="proof-item__label">Clients who continue beyond initial engagement</p>
      </div>
    </div>
  </div>
</section>

<!-- 8. QUOTE -->
<section class="quote-section">
  <div class="container">
    <div class="quote-inner reveal">
      <span class="quote-mark">&ldquo;</span>
      <p class="pull-quote">
        Having Andrew as a strategic guide has changed how we think about marketing. It's not about being busy; it's about being <em>strategic</em>. The difference shows up in our results.
      </p>
      <div class="quote-author">
        <div class="quote-avatar"></div>
        <div class="quote-name">
          <strong>Client Name</strong>
          <span>Title, Company</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 9. JOURNAL / THINKING -->
<section class="section section--light">
  <div class="container">
    <div class="work-header">
      <div class="section-head reveal" style="margin-bottom: 0">
        <span class="eyebrow">Thinking</span>
        <h2>Notes from the <em>work</em>.</h2>
      </div>
      <a href="/blog" class="btn btn--ghost reveal">All writing <span class="arrow">→</span></a>
    </div>

    <div class="journal-grid">
      <div class="journal-card reveal">
        <div class="img-placeholder" style="aspect-ratio: 16/9"><span>Photo</span></div>
        <div class="journal-card__body">
          <div class="journal-card__meta">
            <span class="journal-card__cat">Strategy</span>
            <span class="journal-card__time">5 min read</span>
          </div>
          <h3>When your marketing strategy doesn't match your business strategy</h3>
          <a href="/blog" class="journal-card__link">Read note <span class="arrow">→</span></a>
        </div>
      </div>

      <div class="journal-card reveal d1">
        <div class="img-placeholder" style="aspect-ratio: 16/9"><span>Photo</span></div>
        <div class="journal-card__body">
          <div class="journal-card__meta">
            <span class="journal-card__cat">Technology</span>
            <span class="journal-card__time">4 min read</span>
          </div>
          <h3>AI for marketing leaders: enablement over automation</h3>
          <a href="/blog" class="journal-card__link">Read note <span class="arrow">→</span></a>
        </div>
      </div>

      <div class="journal-card reveal d2">
        <div class="img-placeholder" style="aspect-ratio: 16/9"><span>Photo</span></div>
        <div class="journal-card__body">
          <div class="journal-card__meta">
            <span class="journal-card__cat">Models</span>
            <span class="journal-card__time">6 min read</span>
          </div>
          <h3>The fractional CMO model: when and why it works</h3>
          <a href="/blog" class="journal-card__link">Read note <span class="arrow">→</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 10. CTA BAND -->
<section class="cta-band">
  <div class="container">
    <div class="cta-band__inner">
      <h2>Have something <em>worth</em> building?</h2>
      <div class="cta-band__right">
        <span class="cta-band__email">hello@wearegreaterthan.co.nz</span>
        <a href="mailto:hello@wearegreaterthan.co.nz" class="btn btn--primary-dark">Start a project <span class="arrow">→</span></a>
      </div>
    </div>
  </div>
</section>

</BaseLayout>
