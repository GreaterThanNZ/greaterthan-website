---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Coaching & Leadership" description="Developing your marketing people to the level your business demands. Structured coaching that accelerates growth.">

<!-- HERO -->
<section class="hero hero--sub section--indigo">
  <div class="container">
    <span class="eyebrow eyebrow--light reveal">Layer 3 / Coaching &amp; Leadership</span>
    <h1>Developing your marketing people to the level your business demands</h1>
    <p class="lead">You have good marketing people. They're capable. But your business is growing into demands they haven't faced yet. You need them to step up. Coaching gets them there faster than experience alone.</p>
  </div>
</section>

<!-- WHAT'S INCLUDED -->
<section class="service-detail-layout">
  <div class="container">
    <div class="included-section">
      <h2 class="reveal">What's<br />included</h2>
      <ul class="included-list reveal d1">
        <li>One-on-one coaching</li>
        <li>Strategic mentoring</li>
        <li>Leadership development</li>
        <li>Communication and positioning</li>
        <li>Campaign oversight</li>
        <li>Growth planning</li>
      </ul>
    </div>

    <!-- WHO IT'S FOR -->
    <div class="who-section">
      <h2 class="reveal">Who it's for</h2>
      <div class="who-grid">
        <div class="who-card reveal">
          <h3>Businesses with talented people</h3>
          <p>You have the commitment to develop them and need a structured framework to accelerate growth.</p>
        </div>
        <div class="who-card reveal d1">
          <h3>Leaders scaling their team</h3>
          <p>You need your people to step up faster than they would on their own.</p>
        </div>
        <div class="who-card reveal d2">
          <h3>Businesses preparing for change</h3>
          <p>Mergers, new markets, new channels, or AI integration that demands new skill sets.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- TESTIMONIALS -->
<section class="testimonials-section">
  <div class="container">
    <h2 class="reveal">What clients say</h2>
    <div class="testimonials-grid">
      <div class="testimonial-card reveal">
        <p>"Our marketing manager came into coaching capable but uncertain at a strategic level. Six months later she's leading the planning process and holding her own in the boardroom. The growth was remarkable to watch."</p>
        <cite>
          <strong>Client Name</strong>
          Title, Company
        </cite>
      </div>
      <div class="testimonial-card reveal d1">
        <p>"The coaching wasn't just skills-based. It was about building the confidence to think and act strategically. That's what my team needed, and that's what they got."</p>
        <cite>
          <strong>Client Name</strong>
          Title, Company
        </cite>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta-band">
  <div class="container">
    <div class="cta-band__inner">
      <h2>Ready to develop your <em>people</em>?</h2>
      <div class="cta-band__right">
        <span class="cta-band__email">hello@wearegreaterthan.co.nz</span>
        <a href="/contact" class="btn btn--primary-dark">Book a discovery call <span class="arrow">→</span></a>
      </div>
    </div>
  </div>
</section>

</BaseLayout>
